"<VERSION>1</VERSION>" & vbCrLf & _
"<TALLYREQUEST>Import</TALLYREQUEST>" & vbCrLf & _
"<TYPE>Data</TYPE>" & vbCrLf & _
"<ID>All Masters</ID>" & vbCrLf & _
"</HEADER>" & vbCrLf & _
"<BODY>" & vbCrLf & _
"<DESC>" & vbCrLf & _
"<STATICVARIABLES>" & vbCrLf & _
"<SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>" & vbCrLf & _
